<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2025 runs on .NET 8 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>RevitMcpAddin</AssemblyName>
    <RootNamespace>RevitMcp</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2025</RevitAddinsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After a build, copy the add-in + manifest into Revit's add-in folder -->
  <Target Name="DeployToRevit" AfterTargets="Build">
    <MakeDir Directories="$(RevitAddinsDir)\RevitMcp" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(RevitAddinsDir)\RevitMcp" />
    <Copy SourceFiles="RevitMcp.addin" DestinationFolder="$(RevitAddinsDir)" />
  </Target>

</Project>

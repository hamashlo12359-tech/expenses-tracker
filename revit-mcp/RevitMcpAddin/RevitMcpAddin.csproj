<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2025 runs on .NET 8 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>RevitMcpAddin</AssemblyName>
    <RootNamespace>RevitMcp</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2025</RevitAddinsDir>
  </PropertyGroup>

  <!--
    Revit 2025 API reference assemblies from NuGet, so the add-in builds without
    Revit installed. At runtime Revit supplies its own RevitAPI/RevitAPIUI.
  -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- On Windows, copy the add-in and its manifest into Revit's add-in folder after each build -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(RevitAddinsDir)\RevitMcp" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(RevitAddinsDir)\RevitMcp" />
    <Copy SourceFiles="RevitMcp.addin" DestinationFolder="$(RevitAddinsDir)" />
  </Target>

</Project>
